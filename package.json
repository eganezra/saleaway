{
  "name": "saleaway",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "pnpm --filter @saleaway/web dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "deploy:web": "pnpm --filter @saleaway/web build && pnpm --filter @saleaway/web exec wrangler deploy",
    "deploy:pipeline": "pnpm --filter @saleaway/pipeline exec wrangler deploy",
    "deploy:all": "pnpm deploy:web && pnpm deploy:pipeline"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
