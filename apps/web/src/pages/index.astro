---
import { env } from 'cloudflare:workers';
import AdSlot from '../components/AdSlot.astro';
import CategoryCard from '../components/CategoryCard.astro';
import CategoryChips from '../components/CategoryChips.astro';
import EmptyState from '../components/EmptyState.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { isAdsEnabled } from '../lib/ads';
import { PAGE_CACHE_SECONDS } from '../lib/cache';
import { loadHomeViewModel } from '../lib/homeViewModel';
import { log } from '../lib/log';

// A failing database is a 503. An empty one is a normal 200. Both show the friendly message.
const vm = await loadHomeViewModel(env.DB, log);
if (vm.kind === 'error') Astro.response.status = 503;
// Only a real page may be cached (Story 2.4): the empty page and the 503 are never stored.
Astro.response.headers.set('Cache-Control', vm.kind === 'ok' ? `public, max-age=${PAGE_CACHE_SECONDS}` : 'no-store');
if (vm.kind === 'error') Astro.response.headers.set('Retry-After', '60');
const adsEnabled = isAdsEnabled(env.ADS_ENABLED);
---

<BaseLayout>
  <main id="main" tabindex="-1">
    <h1>Saleaway</h1>
    <p class="intro">Current sales from South African online stores, in one place.</p>
    {
      vm.kind === 'ok' ? (
        <>
          <CategoryChips categories={vm.categories.map(({ slug, name }) => ({ slug, name }))} />
          <AdSlot slot="top" enabled={adsEnabled} />
          <div class="cards">
            {vm.categories.map((category, index) => (
              <>
                <CategoryCard category={category} />
                {index === Math.min(2, vm.categories.length - 1) ? <AdSlot slot="grid" enabled={adsEnabled} /> : null}
              </>
            ))}
          </div>
        </>
      ) : (
        <EmptyState />
      )
    }
  </main>
</BaseLayout>

<style>
  .intro {
    margin: 0 0 24px;
    color: var(--color-muted);
  }

  /* As many cards across as fit, none narrower than 21rem: a row (rank, name, "Checked" label, pill and chevron) needs
     about 290px inside its card, so a narrower card makes the pill drop under the name or the label wrap. That is 1 column
     on a phone, 2 on a tablet and 3 on a desktop (the 1280px content never has room for 4). A plain grid, not a masonry:
     a card is as tall as its rows, and the reading and tab order stay the order of the page. */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(21rem, 100%), 1fr));
    gap: 16px;
    align-items: start;
  }

  @media (min-width: 640px) {
    .cards {
      gap: 24px;
    }
  }
</style>
