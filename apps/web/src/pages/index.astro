---
import { env } from 'cloudflare:workers';
import CategoryCard from '../components/CategoryCard.astro';
import CategoryChips from '../components/CategoryChips.astro';
import EmptyState from '../components/EmptyState.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadHomeViewModel } from '../lib/homeViewModel';
import { log } from '../lib/log';

// A failing database is a 503. An empty one is a normal 200. Both show the friendly message.
const vm = await loadHomeViewModel(env.DB, log);
if (vm.kind === 'error') Astro.response.status = 503;
---

<BaseLayout>
  <main>
    <h1>Saleaway</h1>
    <p class="intro">Current sales from South African online stores, in one place.</p>
    {
      vm.kind === 'ok' ? (
        <>
          <CategoryChips categories={vm.categories.map(({ slug, name }) => ({ slug, name }))} />
          <div class="cards">
            {vm.categories.map((category) => (
              <CategoryCard category={category} />
            ))}
          </div>
        </>
      ) : (
        <EmptyState />
      )
    }
  </main>
</BaseLayout>

<style>
  .intro {
    margin: 0 0 24px;
    color: var(--color-muted);
  }

  /* One column on a phone, then 2, 3 and 4 cards across (the spec's breakpoints). A plain grid, not a masonry: a card is
     as tall as its rows, and the reading and tab order stay the order of the page. */
  .cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    align-items: start;
  }

  @media (min-width: 640px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  @media (min-width: 1024px) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1440px) {
    .cards {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
