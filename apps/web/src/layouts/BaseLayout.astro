---
import { env } from 'cloudflare:workers';
import '../styles/tokens.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { isAdsEnabled } from '../lib/ads';
import { analyticsToken } from '../lib/analytics';
import { FAVICON_HREF, HOME_DESCRIPTION, HOME_TITLE, canonicalUrl, isIndexingAllowed } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  /** The page's own path, for its canonical address and Open Graph URL. */
  path?: string;
}
const { title = HOME_TITLE, description = HOME_DESCRIPTION, path = '/' } = Astro.props;
const canonical = canonicalUrl(env.SITE_URL, path);
const indexable = isIndexingAllowed(env.ALLOW_INDEXING);
const adsEnabled = isAdsEnabled(env.ADS_ENABLED);
const token = analyticsToken(env.CF_WEB_ANALYTICS_TOKEN);
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={FAVICON_HREF} />
    {indexable ? null : <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Saleaway" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_ZA" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <slot />
    <Footer adsEnabled={adsEnabled} />
    <script>
      import '../scripts/site';
    </script>
    {token ? <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token })} /> : null}
  </body>
</html>
