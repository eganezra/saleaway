---
// One store as one link row (Story 2.1). Text only: no retailer images, logos or favicons (NFR7).
import type { StoreRowData } from '../lib/storeRow';
import DiscountPill from './DiscountPill.astro';

interface Props {
  row: StoreRowData;
}
const { row } = Astro.props;
---

<li>
  <a class="store" href={row.saleUrl} target="_blank" rel="noopener noreferrer" data-store={row.slug} aria-label={row.label}>
    <span class="text">
      <span class="name">{row.name}</span>
      <span class={`checked checked--${row.checkedAge}`}>{row.checkedText}</span>
    </span>
    <DiscountPill percent={row.percent} tier={row.tier} />
    <span class="chevron" aria-hidden="true">›</span>
  </a>
</li>

<style>
  .store {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    height: 100%;
    padding: 12px 16px;
    background: var(--color-surface);
    color: var(--color-ink);
    border: 3px solid var(--color-ink);
    box-shadow: 4px 4px 0 var(--color-ink);
    text-decoration: none;
  }

  /* The name keeps at least 7rem; when the row is too narrow for that (a 320px phone, or two columns just above 640px) the
     pill drops to its own line instead of squeezing the name into broken words. */
  .text {
    display: flex;
    flex: 1 1 7rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    min-width: 0;
  }

  /* The name wraps onto a second line and is never cut off with an ellipsis. */
  .name {
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .store:visited .name {
    color: var(--color-muted);
  }

  /* The words carry the meaning ("Checked 2 days ago"); the colour only helps. */
  .checked {
    padding: 2px 6px;
    color: var(--color-ink);
    font-size: 0.8125rem;
    line-height: 1.3;
  }

  .checked--today {
    background: var(--color-mint);
  }

  .checked--older {
    background: var(--color-yellow);
  }

  .checked--never {
    padding-left: 0;
    color: var(--color-subtle);
  }

  .chevron {
    flex: none;
    color: var(--color-subtle);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
  }

  @media (hover: hover) {
    .store:hover {
      box-shadow: 2px 2px 0 var(--color-ink);
      transform: translate(2px, 2px);
    }
  }

  .store:active {
    box-shadow: 0 0 0 var(--color-ink);
    transform: translate(4px, 4px);
  }
</style>
