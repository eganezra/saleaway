---
// One store as one link row inside a category card (Stories 2.1 and 2.2). Text only: no retailer images, logos or favicons (NFR7).
import type { PositionedRow } from '../lib/categories';
import DiscountPill from './DiscountPill.astro';

interface Props {
  row: PositionedRow;
}
const { row } = Astro.props;
---

<li>
  {/* The spaces between the parts are real text: the link's visible text then reads "Name Checked today Up to 60% off", which is what the accessible name has to contain. Flex containers do not draw them. */}
  <a class="store" href={row.saleUrl} target="_blank" rel="noopener noreferrer" data-store={row.slug} data-position={row.position} aria-label={row.label}>
    <span class="text">
      <span class="name">{row.name}</span>{' '}
      <span class={`checked checked--${row.checkedAge}`}>{row.checkedText}</span>
    </span>{' '}
    <DiscountPill percent={row.percent} tier={row.tier} />
  </a>
</li>

<style>
  li {
    border-bottom: 2px solid var(--color-ink);
  }

  li:last-child {
    border-bottom: 0;
  }

  .store {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding: 8px 2px;
    color: var(--color-ink);
    text-decoration: none;
  }

  /* The rank number and the chevron are drawn with generated content, not text in the link, so the link's visible text is exactly
     its name, its "Checked" words and its figure, and its accessible name can hold all of that (WCAG 2.5.3, Label in Name). The
     list already numbers the rows for a screen reader; `/ ''` gives the generated content no spoken text. The first declaration
     is the fallback for a browser that does not know the second. */
  .store::before {
    content: attr(data-position);
    content: attr(data-position) / '';
    flex: none;
    min-width: 1.25rem;
    color: var(--color-subtle);
    font-size: 0.875rem;
    font-weight: 700;
    text-align: right;
  }

  /* The name keeps at least 5.5rem; when the row is too narrow for that (a 320px phone) the pill drops to its own line
     instead of squeezing the name into broken words. At 360px the pill stays on the right (the spec). */
  .text {
    display: flex;
    flex: 1 1 5.5rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    min-width: 0;
  }

  /* The name wraps onto a second line and is never cut off with an ellipsis. */
  .name {
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .store:visited .name {
    color: var(--color-muted);
  }

  /* The words carry the meaning ("Checked 2 days ago"); the colour only helps. */
  .checked {
    padding: 2px 6px;
    color: var(--color-ink);
    font-size: 0.8125rem;
    line-height: 1.3;
  }

  .checked--today {
    background: var(--color-mint);
  }

  .checked--older {
    background: var(--color-yellow);
  }

  .checked--never {
    padding-left: 0;
    color: var(--color-subtle);
  }

  .store::after {
    content: '›';
    content: '›' / '';
    flex: none;
    color: var(--color-subtle);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
  }

  /* Only the cream, never yellow or mint: the grey rank number is 4.9:1 on the cream and only 3.7:1 on those. */
  @media (hover: hover) {
    .store:hover {
      background: var(--color-page);
    }
  }

  .store:active {
    background: var(--color-page);
  }

  .store:active .name {
    text-decoration: underline;
  }
</style>
