{
  "name": "saleaway-web",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saleaway",
      "database_id": "0395d5e7-f570-4468-b2f2-b64c8e4f8ecc",
      "migrations_dir": "../../db/migrations"
    }
  ],
  "vars": {
    "SITE_URL": "https://saleaway.online",
    "ALLOW_INDEXING": "false",
    "ADS_ENABLED": "false",
    "CLICK_SAMPLE_RATE": "1",
    "CF_WEB_ANALYTICS_TOKEN": ""
  },
  // Story 4.4: the real address. Each hostname is its own custom domain (an exact match, no wildcard): the Worker answers both and
  // sends `www` to the apex with a 301 (src/lib/host.ts). The first deploy creates the DNS records and the certificates.
  "routes": [
    { "pattern": "saleaway.online", "custom_domain": true },
    { "pattern": "www.saleaway.online", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
